{
  "description": "Reports real token savings from the session transcript on request.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/stats-hook.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
